{
  "name": "the-soul-barber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build && vite build --ssr src/entry-server.ts --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/ scripts/"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.0",
    "vue": "^3.5.44",
    "vue-i18n": "^10.0.8"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.6",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.7.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.5.3",
    "typescript": "~5.8.0",
    "vite": "^7.3.7",
    "vue-tsc": "^2.2.12"
  }
}
